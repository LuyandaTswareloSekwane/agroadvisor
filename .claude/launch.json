{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "worker", "run", "dev"],
      "port": 8787
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5173
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "firebase-tools@latest", "emulators:start", "--project", "demo-agroadvisor"],
      "port": 4000
    },
    {
      "name": "client-emulator",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev:emulator"],
      "port": 5173
    }
  ]
}
