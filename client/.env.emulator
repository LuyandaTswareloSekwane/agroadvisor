# Used by `npm run dev:emulator` (vite --mode emulator). Overrides .env.
# Points the app at the local Firebase emulators with a throwaway "demo-" project,
# so nothing touches the real Firebase project. These values are not secrets.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-agroadvisor.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-agroadvisor
VITE_FIREBASE_STORAGE_BUCKET=demo-agroadvisor.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
